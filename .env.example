# Copie este arquivo para ".env" e ajuste os valores antes de rodar.
# Este mini-CRM agora usa PostgreSQL (mesmo servidor do stack n8n é ok).

# Porta em que o servidor vai escutar
PORT=3000

# ---------------------------------------------------------------------------
# Banco de dados PostgreSQL
# ---------------------------------------------------------------------------
# Preencha OU a URL completa OU os campos separados (o app monta a URL).
# Exemplo (mesmo Postgres do stack n8n, banco dedicado):
DATABASE_URL=postgres://postgres:1e87e0ed74d4695636158f91091f8860@postgres:5432/mini_crm

# Alternativa usando campos separados (usados se DATABASE_URL estiver vazio):
# POSTGRES_HOST=postgres
# POSTGRES_PORT=5432
# POSTGRES_USER=postgres
# POSTGRES_PASSWORD=1e87e0ed74d4695636158f91091f8860
# POSTGRES_DB=mini_crm

# Chave de criptografia dos tokens OAuth2 do Google (use 32 caracteres fixos).
# Troque por algo aleatório e NÃO mude depois de produzir dados (senão os
# tokens salvos não poderão mais ser descriptografados).
ENCRYPTION_KEY=troque-por-uma-chave-aleatoria-de-32-chars

# Senha do usuário admin (criado automaticamente na primeira subida).
# Mude para uma senha forte.
ADMIN_PASSWORD=_Senha@1234

# ---------------------------------------------------------------------------
# Google Calendar (OAuth2) — uma credencial de PROJETO para todos os clientes
# ---------------------------------------------------------------------------
# Crie um projeto em https://console.cloud.google.com -> APIs & Services.
# Ative: Google Calendar API, Google+ API (ou People API) para pegar o e-mail.
# Crie credenciais OAuth2 (Web application) e autorize o redirect abaixo.
# ATENÇÃO: em produção use o domínio real (ex: https://crm.seudominio.com.br/api/google/oauth/callback).
GOOGLE_CLIENT_ID=SEU_CLIENT_ID.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=SEU_CLIENT_SECRET
GOOGLE_REDIRECT_URI=https://crm.autofunil.com.br/api/google/oauth/callback

# Importar dados do db.json legado na primeira subida? (true/false)
IMPORT_LEGACY=true

# ---------------------------------------------------------------------------
# WhatsApp (Evolution API) — canal de entrada de leads
# ---------------------------------------------------------------------------
# O provisionamento da instância é feito no painel da Evolution (o CRM só
# recebe o webhook e guarda a referência). Preencha apenas a URL pública do
# CRM, usada para montar o webhook: <CRM_BASE_URL>/api/evolution/webhook.
CRM_BASE_URL=https://crm.autofunil.com.br